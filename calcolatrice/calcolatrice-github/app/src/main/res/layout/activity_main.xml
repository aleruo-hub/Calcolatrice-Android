<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0F172A"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/dysplay2"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:text=""
                android:textColor="#94A3B8"
                android:textSize="25sp" />

            <TextView
                android:id="@+id/dysplayOperatore"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:text=""
                android:textColor="#60A5FA"
                android:textSize="25sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334155" />

        <TextView
            android:id="@+id/dysplay1"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:gravity="end|center_vertical"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="38sp"
            android:maxLines="1"
            android:ellipsize="start" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334155" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Memoria: "
                android:textColor="#94A3B8"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/dysplayMemoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="MS"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0F766E"
                android:onClick="clickMS" />

            <Button
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="MC"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0F766E"
                android:onClick="clickMC" />

            <Button
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="MR"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0F766E"
                android:onClick="clickMR" />

            <Button
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="C"
                android:textColor="#FFFFFF"
                android:backgroundTint="#B84152"
                android:onClick="clickC" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="7"
                android:textColor="#FFFFFF"
                android:backgroundTint="#273449"
                android:onClick="clickDigit" />

            <Button
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="8"
                android:textColor="#FFFFFF"
                android:backgroundTint="#273449"
                android:onClick="clickDigit" />

            <Button
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="9"
                android:textColor="#FFFFFF"
                android:backgroundTint="#273449"
                android:onClick="clickDigit" />

            <Button
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="+"
                android:textColor="#FFFFFF"
                android:backgroundTint="#315B9A"
                android:onClick="clickOp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="4"
                android:textColor="#FFFFFF"
                android:backgroundTint="#273449"
                android:onClick="clickDigit" />

            <Button
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="5"
                android:textColor="#FFFFFF"
                android:backgroundTint="#273449"
                android:onClick="clickDigit" />

            <Button
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="6"
                android:textColor="#FFFFFF"
                android:backgroundTint="#273449"
                android:onClick="clickDigit" />

            <Button
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="-"
                android:textColor="#FFFFFF"
                android:backgroundTint="#315B9A"
                android:onClick="clickOp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="1"
                android:textColor="#FFFFFF"
                android:backgroundTint="#273449"
                android:onClick="clickDigit" />

            <Button
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="2"
                android:textColor="#FFFFFF"
                android:backgroundTint="#273449"
                android:onClick="clickDigit" />

            <Button
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="3"
                android:textColor="#FFFFFF"
                android:backgroundTint="#273449"
                android:onClick="clickDigit" />

            <Button
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="×"
                android:textColor="#FFFFFF"
                android:backgroundTint="#315B9A"
                android:onClick="clickOp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="."
                android:textColor="#FFFFFF"
                android:backgroundTint="#273449"
                android:onClick="clickDot" />

            <Button
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:backgroundTint="#273449"
                android:onClick="clickDigit" />

            <Button
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="="
                android:textColor="#FFFFFF"
                android:backgroundTint="#2563EB"
                android:onClick="clickEq" />

            <Button
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="÷"
                android:textColor="#FFFFFF"
                android:backgroundTint="#315B9A"
                android:onClick="clickOp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
